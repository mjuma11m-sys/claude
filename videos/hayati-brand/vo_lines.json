[
 {
  "t": 0.25,
  "end": 4.9,
  "text": "هلا! هذا حياتي… يومك كله بمكان واحد"
 },
 {
  "t": 5.15,
  "end": 7.46,
  "text": "يعرف وش وقته الحين"
 },
 {
  "t": 7.9,
  "end": 10.76,
  "text": "الماي، النوم، وعاداتك اليومية"
 },
 {
  "t": 11.4,
  "end": 13.32,
  "text": "مصاريفك تحت عينك"
 },
 {
  "t": 14.9,
