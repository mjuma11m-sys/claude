{
  "name": "idarati",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "node tests/e2e.mjs",
    "test:sync": "esbuild tests/sync.test.ts --bundle --platform=node --format=esm --jsx=automatic --loader:.svg=empty --outfile=node_modules/.cache/sync.test.mjs --log-level=warning && node node_modules/.cache/sync.test.mjs",
    "test:db": "bash supabase/tests/run.sh",
    "build:vercel": "tsc --noEmit && vite build --outDir ../idarati-app --emptyOutDir"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.49.4",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.4",
    "playwright-core": "^1.64.0",
    "typescript": "5.6.3",
    "vite": "5.4.11"
  }
}
