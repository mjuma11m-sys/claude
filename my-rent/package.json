{
  "name": "idarati",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "node tests/compat.mjs && node tests/e2e.mjs",
    "test:sync": "esbuild tests/sync.test.ts --bundle --platform=node --format=esm --jsx=automatic --loader:.svg=empty --outfile=node_modules/.cache/sync.test.mjs --log-level=warning && node node_modules/.cache/sync.test.mjs",
    "test:track": "esbuild tests/track.test.ts --bundle --platform=node --format=esm --jsx=automatic --loader:.svg=empty --outfile=node_modules/.cache/track.test.mjs --log-level=warning && node node_modules/.cache/track.test.mjs",
    "test:db": "bash supabase/tests/run.sh",
    "build:vercel": "tsc --noEmit && vite build --outDir ../idarati-app --emptyOutDir",
    "cap:sync": "npm run build && cap sync",
    "cap:assets": "node tools/native-assets.mjs"
  },
  "dependencies": {
    "@aparajita/capacitor-biometric-auth": "^10.0.0",
    "@capacitor/android": "^8.5.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/browser": "^8.0.5",
    "@capacitor/core": "^8.5.3",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/ios": "^8.5.3",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/share": "^8.0.3",
    "@supabase/supabase-js": "2.49.4",
    "fflate": "0.8.3",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "read-excel-file": "9.3.10",
    "write-excel-file": "4.1.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.4",
    "axe-core": "^4.10.2",
    "playwright-core": "^1.64.0",
    "typescript": "5.6.3",
    "vite": "5.4.11"
  }
}
